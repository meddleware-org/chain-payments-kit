{
  "name": "@meddleware/chain-payments-kit",
  "version": "0.0.2",
  "description": "Vue checkout for Chain Payments: shows the exact price, builds the payment through the chain modules, follows it to confirmation.",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/chain-payments-kit.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "extends @meddleware/frontend-config/browserslist-config"
  ],
  "scripts": {
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint:html": "html-validate \"src/**/*.vue\"",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "build:gallery": "vite build --config vite.gallery.config.ts",
    "test:e2e": "playwright test",
    "shots": "SHOTS=1 playwright test"
  },
  "peerDependencies": {
    "@meddleware/chain-payments-client": "^0.0.1",
    "@meddleware/design-tokens": "^0.1.13",
    "@meddleware/ui": "^0.1.43",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@meddleware/chain-payments-client": "0.0.1",
    "@meddleware/design-tokens": "^0.1.13",
    "@meddleware/frontend-config": "^0.0.10",
    "@meddleware/ui": "^0.1.43",
    "@mysten/sui": "^2.39.1",
    "@playwright/test": "~1.64.1",
    "@types/node": "~26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "html-validate": "^11.18.0",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vitest": "~5.1.0",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.14"
  },
  "overrides": {
    "basic-ftp": "^6.2.4",
    "tmp": "^0.2.7",
    "zod": "^4.6.7"
  }
}
